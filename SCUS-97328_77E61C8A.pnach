gametitle=Gran Turismo 4 [SCUS-97328] (U)

// Use this file INSTEAD of FlarePerformance.pnach (it replaces the cap and cull sections there).
// Do not combine with HalfFlares.pnach, DisableSunFlare.pnach or ToggleCarLights.pnach.
// Every patch address and original instruction was checked against the decompressed CORE.GT4 (US, CRC 77E61C8A).
// Address -> file offset in the unpacked image: offset = address - 0x100000 + 0x134.
// Not runtime-tested in PCSX2: enable one section at a time.
//
// ALTERNATIVE GROUPS - enable at most ONE section from each group (members write the same addresses):
//   Flare Cap 4 / 6 / 8 / 12 / 16 / 20 / 24 / 32
//   Flare Distance Cull 25 / 40 / 60 / 80 / 100
//   Flare Glow Large / Medium / Small / Tiny
//   Sun Flare Half / Quarter / Eighth Size / Off
// INDEPENDENT (can be combined with anything): Flare Halo Pass Off, Streak Lights Off.
// "Lamp Flares Off (Max Speed)" makes the caps, culls, glow and halo sections pointless; use it on its own.
// Cull, Glow and Sun sections use unused padding (all zeros in the original) for stub code.

[Flare Cap 4]
description=Max 4 lamp flares and 4 track-light flares queued per frame (game default 100).
author=Generated from disassembly of CORE.GT4

// Last hex digits are the cap: 0x04 = 4.
patch=1,EE,203B7BA8,extended,28460004
patch=1,EE,203B8568,extended,28620004

