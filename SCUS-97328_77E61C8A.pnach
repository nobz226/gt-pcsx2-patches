[Sun Flare Half Size]
description=Draws the sun flare at 50% width and height instead of full size.
author=Generated from disassembly of CORE.GT4

// The sun flare draw call at 0x003B89E0 is redirected to a stub in padding (0x00495580) that
// multiplies the size argument (f12) by 0.5 and then jumps to the original draw function.
// Constant 0x3F00 = 0.5. Enable only one Sun Flare section.
patch=1,EE,20495580,extended,3C013F00
patch=1,EE,20495584,extended,44810800
patch=1,EE,20495588,extended,0812617E
patch=1,EE,2049558C,extended,46016302
patch=1,EE,203B89E0,extended,0C125560

