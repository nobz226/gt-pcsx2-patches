[Flare Halo Pass Off]
description=Removes the second, larger halo sprite that lamp and track-light flares draw when close to the camera.
author=Generated from disassembly of CORE.GT4

// The flare draw function 0x00498198 draws the main glow, then a second bigger halo sprite when the
// light is closer than a set range (it sets s5=1 in a branch delay slot at 0x0049823C).
// Setting s5 to 0 there skips that second draw entirely. Nearby lights still glow, but without the
// big halo. Large close-up sprites are the most expensive part on the GPU.
patch=1,EE,2049823C,extended,24150000

[Flare Glow Large]
description=Draws every lamp/track-light glow at 75% width and height (about 56% of the screen area). Same lights, same colours, less GPU overdraw.
author=Generated from disassembly of CORE.GT4

// In the flare draw function 0x00498198, "mov.s f25,f17" at 0x004981DC copies the main glow size.
// It is replaced by a jump to a stub in padding (0x00495640) that stores size * 0.75 in f25, then returns to 0x004981E4.
// The delay slot (0x004981E0, swc1 f24,88(sp)) still runs, so nothing is skipped. f0 and at are free at that point.
// Original word at 0x004981DC: 46008E46. Constant 0x3F40 = 0.75.
patch=1,EE,20495640,extended,3C013F40
patch=1,EE,20495644,extended,44810000
patch=1,EE,20495648,extended,46008E42
patch=1,EE,2049564C,extended,08126079
patch=1,EE,20495650,extended,00000000
patch=1,EE,204981DC,extended,08125590

