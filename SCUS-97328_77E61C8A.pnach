[Flare Distance Cull 25]
description=Skips lamp/track-light flares farther than ~25 units from the camera. Higher = more flares drawn = more taxing.
author=Generated from disassembly of CORE.GT4

// Both queues call one visibility test (0x003B7C98). Its return is redirected to a stub in padding
// that reports "not visible" when the view distance is above a threshold.
// The stub reads the view-space depth stored at 8(a2) by the visibility function, so a2 must be left untouched.
// The threshold is the float set by "lui at,0x41C8" (0x41C80000 = 25.0).
patch=1,EE,203B7DCC,extended,0812557C
patch=1,EE,204955F0,extended,10400008
patch=1,EE,204955F4,extended,C4C00008
patch=1,EE,204955F8,extended,3C0141C8
patch=1,EE,204955FC,extended,44810800
patch=1,EE,20495600,extended,46000834
patch=1,EE,20495604,extended,00000000
patch=1,EE,20495608,extended,45000002
patch=1,EE,2049560C,extended,00000000
patch=1,EE,20495610,extended,0000102D
patch=1,EE,20495614,extended,03E00008
patch=1,EE,20495618,extended,00000000

