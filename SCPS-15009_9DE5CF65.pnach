[Sun Flare Half Size]
description=Draws the sun flare at 50% width and height instead of full size.
author=Generated from disassembly of CORE.GT3

// The sun flare draw call at 0x0019A298 (jal 0x00244E00) is redirected to a stub in padding (0x0028C16C) that
// multiplies the size argument (f12) by 0.5 and then jumps to the original draw function.
// Constant 0x3F00 = 0.5. Enable only one Sun Flare section.
patch=1,EE,2019A298,extended,0C0A305B
patch=1,EE,2028C16C,extended,3C013F00
patch=1,EE,2028C170,extended,44810800
patch=1,EE,2028C174,extended,08091380
patch=1,EE,2028C178,extended,46016302

