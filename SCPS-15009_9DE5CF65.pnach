[Flare Halo Pass Off]
description=Removes the second, larger halo sprite that lamp and track-light flares draw when close to the camera.
author=Generated from disassembly of CORE.GT3

// The flare draw function 0x00244990 (same code as GT4's 0x00498198) draws the main glow, then a second bigger halo
// sprite when the light is closer than a set range (it sets s5=1 in a branch delay slot at 0x00244A38).
// Setting s5 to 0 there skips that second draw entirely. Nearby lights still glow, but without the big halo.
patch=1,EE,20244A38,extended,24150000

[Flare Glow Large]
description=Draws every lamp/track-light glow at 75% width and height (about 56% of the screen area). Same lights, same colours, less GPU overdraw.
author=Generated from disassembly of CORE.GT3

// In the flare draw function 0x00244990, "mov.s f25,f17" at 0x002449D8 copies the main glow size.
// It is replaced by a jump to a stub in padding (0x0028C15C) that stores size * 0.75 in f25 (the multiply sits in the jump's
// delay slot), then returns to 0x002449E0. The original delay slot (0x002449DC, swc1 f23,0x88(sp)) still runs, so nothing is
// skipped. f0 and at are free at that point.
// Original word at 0x002449D8: 46008E46. Constant 0x3F40 = 0.75.
patch=1,EE,202449D8,extended,080A3057
patch=1,EE,2028C15C,extended,3C013F40
patch=1,EE,2028C160,extended,44810000
patch=1,EE,2028C164,extended,08091278
patch=1,EE,2028C168,extended,46008E42

