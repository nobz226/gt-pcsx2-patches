// so the stub is just: lw t0,8(a2) / lui t1,thr / sltu t0,t1,t0 / jr ra / movn v0,zero,t0 (delay slot).
// The threshold is the float set by "lui t1,0x4220" (0x42200000 = 40.0). GT3 world scale is not verified, so tune this by eye.
patch=1,EE,201996AC,extended,080A3052
patch=1,EE,2028C148,extended,8CC80008
patch=1,EE,2028C14C,extended,3C094220
patch=1,EE,2028C150,extended,0128402B
patch=1,EE,2028C154,extended,03E00008
patch=1,EE,2028C158,extended,0008100B

