[Flare Distance Cull 25]
description=Skips lamp/track-light flares farther than ~25 units from the camera. Higher = more flares drawn = more taxing.
author=Generated from disassembly of CORE.GT3

// Both queues (0x00199458 track lights, 0x00199E00 car lamps) call one visibility test (0x00199580). Its final "jr ra"
// (0x001996AC) is redirected to a stub in padding that treats the flare as not visible when the view distance is above a
// threshold. The distance is the float that the test stores at 8(a2). Positive floats compare correctly as unsigned integers,
// so the stub is just: lw t0,8(a2) / lui t1,thr / sltu t0,t1,t0 / jr ra / movn v0,zero,t0 (delay slot).
// The threshold is the float set by "lui t1,0x41C8" (0x41C80000 = 25.0). GT3 world scale is not verified, so tune this by eye.
patch=1,EE,201996AC,extended,080A3052
patch=1,EE,2028C148,extended,8CC80008
patch=1,EE,2028C14C,extended,3C0941C8
patch=1,EE,2028C150,extended,0128402B
patch=1,EE,2028C154,extended,03E00008
patch=1,EE,2028C158,extended,0008100B

